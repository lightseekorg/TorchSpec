+def test_cache_hidden_states_accepts_pipeline_local_layers():
+    """A PP stage writes only its owned layer slots into the shared cache layout."""
+    device = torch.device(DEVICE_TYPE)
+    proposer = _create_proposer(layer_ids=[2, 8, 14, 20])
+    proposer.local_hidden_state_indices = (1, 3)
+    proposer.model = mock.MagicMock()
+    proposer.attn_layer_names = ["cache_only_layers.28"]
+    proposer.attn_metadata_builder = mock.MagicMock()
+
+    batch_spec = BatchSpec(seq_lens=[3], query_lens=[3])
+    common_attn_metadata = create_common_attn_metadata(
+        batch_spec,
+        block_size=16,
+        device=device,
+    )
+    local_hidden_states = [
+        torch.randn(3, proposer.hidden_size, dtype=proposer.dtype, device=device)
+        for _ in range(2)
+    ]
+
+    proposer.cache_hidden_states(local_hidden_states, common_attn_metadata)
+
+    assert torch.equal(
+        proposer.hidden_states[:3, 1],
+        local_hidden_states[0],
+    )
+    assert torch.equal(
+        proposer.hidden_states[:3, 3],
+        local_hidden_states[1],
+    )
+    assert not proposer.hidden_states[:3, 0].any()
+    assert not proposer.hidden_states[:3, 2].any()
+    proposer.model.assert_called_once()
+
+
+def test_non_last_pp_stage_flushes_before_completion_barrier():
+    runner = GPUModelRunner.__new__(GPUModelRunner)
+    runner.execute_model_state = None
+    runner.speculative_config = mock.MagicMock()
+    runner.speculative_config.uses_extract_hidden_states.return_value = True
+    runner.kv_connector_output = None
+    runner.use_async_scheduling = False
+
+    events = []
+    runner.finalize_kv_connector = mock.MagicMock(
+        side_effect=lambda: events.append("flush")
+    )
+    pp_group = mock.MagicMock(world_size=4)
+    pp_group.barrier.side_effect = lambda: events.append("barrier")
+
+    with mock.patch(
+        "vllm.v1.worker.gpu_model_runner.get_pp_group",
+        return_value=pp_group,
+    ):
+        runner.sample_tokens(grammar_output=None)
+
+    assert events == ["flush", "barrier"]
+
+
+def test_extract_hidden_states_prefill_only_skips_sampler():
+    runner = GPUModelRunner.__new__(GPUModelRunner)
+    runner.speculative_config = mock.MagicMock()
+    runner.speculative_config.uses_extract_hidden_states.return_value = True
+    runner.kv_connector_output = None
+    runner.supports_mm_inputs = False
+    runner.finalize_kv_connector = mock.MagicMock()
+    runner.eplb_step = mock.MagicMock()
+    runner._sample = mock.MagicMock(
+        side_effect=AssertionError("extract-only path must not sample")
+    )
+
+    scheduler_output = mock.MagicMock()
+    scheduler_output.num_scheduled_tokens = {"req-0": 7}
+    runner.execute_model_state = ExecuteModelState(
+        scheduler_output=scheduler_output,
+        logits=None,
+        spec_decode_metadata=None,
+        spec_decode_common_attn_metadata=None,
+        hidden_states=mock.MagicMock(),
+        sample_hidden_states=mock.MagicMock(),
+        aux_hidden_states=None,
+        ec_connector_output=None,
+        cudagraph_stats=None,
+        slot_mappings=None,
+    )
+
+    with mock.patch(
+        "vllm.v1.worker.gpu_model_runner.get_pp_group",
+        return_value=mock.MagicMock(world_size=1),
+    ):
+        output = runner.sample_tokens(grammar_output=None)
+
+    assert output.prefill_only
+    assert output.sampled_token_ids == [[]]
+    assert output.req_ids == ["req-0"]
+    runner._sample.assert_not_called()
+    runner.finalize_kv_connector.assert_called_once()
